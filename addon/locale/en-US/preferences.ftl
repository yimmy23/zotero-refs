pref-title = Refs Settings

pref-group-refresh = Reference List
pref-autoRefresh =
    .label = Fetch references automatically when an item is shown
pref-notAutoRefreshItemTypes = Skip auto-fetch for item types (comma separated, English type names)
pref-prioritySource = Preferred source for the first fetch
pref-source-pdf =
    .label = PDF
pref-source-api =
    .label = Web API
pref-preLoadingPageNum = Pages scanned from the end of the PDF
pref-savePDFReferences =
    .label = Cache references parsed from PDF
pref-saveAPIReferences =
    .label = Cache references fetched from web APIs
pref-notInLibraryOpacity = Row opacity for references not in your library (0.1–1)

pref-group-popup = Hover Popup
pref-showPopup =
    .label = Show a floating card when hovering a reference
pref-popupDelay = Show delay (ms)
pref-popupRemoveDelay = Hide delay (ms)
pref-ctrlClickTranslate =
    .label = Ctrl+click title/abstract to translate (needs Translate for Zotero plugin)

pref-group-reader = PDF Reader Links
pref-clickLink =
    .label = Open in-text jump links (figures, equations) in a split view
pref-clickLinkCmd = Split direction
pref-split-horizontally =
    .label = Horizontal
pref-split-vertically =
    .label = Vertical
pref-hoverLink =
    .label = Show reference popup when hovering an in-text citation link

pref-group-sections = Extra Sections
pref-loadingRelated =
    .label = Load related-paper recommendations
pref-loadingCitations =
    .label = Load "Cited By" list automatically
pref-citationsPageSize = Citations per page
pref-graphEnable =
    .label = Enable the citation graph section
pref-graphMaxNodes = Maximum nodes in the graph

pref-group-network = Network
pref-email = Contact email (Crossref / OpenAlex / Unpaywall grant faster, more reliable access — the "polite pool")
pref-s2ApiKey = Semantic Scholar API key (optional)
pref-cacheTTLHours = Network response cache lifetime (hours, this session only; reference lists are cached separately)

pref-group-cnki = CNKI 知网研学 (only for CNKI reference lists)
pref-cnki-username = Username
pref-cnki-password = Password

pref-help = { $name } Build { $version } { $time }
