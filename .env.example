# Isolated development only. Resolve these paths to this checkout.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_PROFILE_PATH = .scaffold/dev-profile
ZOTERO_PLUGIN_DATA_DIR = .scaffold/dev-data
# On macOS/Linux this matches only the isolated profile command line.
# Windows users must provide a profile-scoped process command before serving.
ZOTERO_PLUGIN_KILL_COMMAND = pkill -f '[r]eferences-plugin/.scaffold/dev-profile' || true
# Use a connector port distinct from your normal Zotero instance.
# Set extensions.zotero.httpServer.port = 23126 in the dev profile.
